/* Progress Bar Styling */
QProgressBar {
    border: 1px solid #444;
    border-radius: 5px;
    text-align: center;
    background-color: #222;
    color: transparent; /* Hide text inside the progress bar */
    height: 20px;
}

QProgressBar::chunk {
    background-color: #3498db;
    width: 10px;
    margin: 0.5px;
    border-radius: 3px;
}

/* Style for progress bar labels */
QLabel[progressLabel="true"] {
    color: white;
    font-size: 11px;
    margin-bottom: 2px;
}

/* Style for progress percentage label */
QLabel[progressPercentage="true"] {
    color: #3498db;
    font-size: 12px;
    font-weight: bold;
    margin-left: 5px;
}

/* Modern Scrollbar Styling */
QScrollBar:vertical {
    border: none;
    background: #2d2d2d;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #555;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #2d2d2d;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #555;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
