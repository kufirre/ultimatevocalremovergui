/* Basic Dark Theme QSS Stylesheet for UVR PySide6 App */

QWidget {
    font-family: "Montserrat", "Century Gothic", sans-serif; /* Prioritize Montserrat, fallback to Century Gothic, then generic sans-serif */
    color: #e0e0e0; /* Light text for a dark theme */
    background-color: #2c3e50; /* Dark bluish-grey background */
    font-size: 10pt; /* Base font size */
}

QMainWindow {
    background-color: #233140; /* Slightly darker for main window */
}

QPushButton {
    background-color: #34495e; /* Slightly lighter bluish-grey */
    border: 1px solid #4a637a;
    padding: 6px 12px;
    border-radius: 4px;
    color: #ecf0f1; /* Light text for buttons */
}

QPushButton:hover {
    background-color: #4a637a;
    border-color: #5c7a96;
}

QPushButton:pressed {
    background-color: #2c3e50;
}

QPushButton:disabled {
    background-color: #2c3e50;
    color: #7f8c8d;
    border-color: #34495e;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #1c2833; /* Darker input fields */
    border: 1px solid #4a637a;
    padding: 4px;
    border-radius: 3px;
    color: #ecf0f1;
}

QComboBox::drop-down {
    border: none;
    background-color: #34495e;
}

QComboBox::down-arrow {
    image: url(:/uvr/img/down.png); /* Example: We'll need to ensure this image is in QRC and path is correct */
    width: 12px;
    height: 12px;
}


QProgressBar {
    border: 1px solid #4a637a;
    border-radius: 3px;
    text-align: center;
    color: #ecf0f1;
    background-color: #1c2833;
}

QProgressBar::chunk {
    background-color: #3498db; /* A nice blue accent color */
    /* width: 10px; */ /* Auto width is usually fine */
    margin: 0.5px;
    border-radius: 2px;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #4a637a;
    margin-top: 12px; /* Space for the title */
    padding: 10px;
    padding-top: 15px; /* Extra padding at the top inside the box */
    border-radius: 4px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    left: 10px;
    color: #bdc3c7; /* Lighter title color */
    background-color: #2c3e50; /* Match QWidget background for the title's bg */
}

QTabWidget::pane { /* The container for tabs */
    border: 1px solid #4a637a;
    border-top: none; /* Pane border often looks better without top if tabs have bottom border */
    background-color: #233140; /* Match main window or slightly different */
}

QTabBar::tab {
    background: #34495e;
    border: 1px solid #4a637a;
    border-bottom: none; /* Or a different color to merge with pane */
    padding: 8px 15px;
    margin-right: 2px; /* Space between tabs */
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #ecf0f1;
}

QTabBar::tab:selected {
    background: #2c3e50; /* Background of the active tab, matching QWidget */
    color: #ffffff;
    /* border-bottom-color: #2c3e50; */ /* Make selected tab merge with pane */
}

QTabBar::tab:!selected:hover {
    background: #4a637a;
}

QScrollArea {
    border: none; /* Or 1px solid #4a637a; if you want a border */
}

QScrollBar:vertical {
    border: 1px solid #4a637a;
    background: #1c2833;
    width: 12px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #3498db;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
    width: 0px;
}

QScrollBar:horizontal {
    border: 1px solid #4a637a;
    background: #1c2833;
    height: 12px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:horizontal {
    background: #3498db;
    min-width: 20px;
    border-radius: 5px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    height: 0px;
    width: 0px;
}

/* Add more specific styles as needed */
/* For example, for QToolTip, QLabel, etc. */
QToolTip {
    color: #2c3e50; /* Dark text for light tooltip */
    background-color: #ecf0f1; /* Light background for tooltip */
    border: 1px solid #bdc3c7;
    padding: 4px;
    border-radius: 3px;
}

/* Specific object styles */
QPushButton#prominentButton {
    font-size: 12pt; /* Adjusted from 14px to 12pt for consistency with 10pt base */
    padding: 10px 15px; /* Adjusted padding */
    /* You can add other specific properties here if needed, like a different background or border */
}

QTextEdit#logConsole {
    font-family: "Courier New", Courier, monospace;
    font-size: 9pt; /* Adjusted from 10px to 9pt */
    background-color: #1a252f; /* Slightly different background for log */
    color: #c0c0c0; /* Lighter grey for log text */
}
